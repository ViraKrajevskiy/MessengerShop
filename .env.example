# ─────────────────────────────────────────────────────────────────
#  .env.example — скопируй в .env и заполни свои значения
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# Django
# DEBUG ОБЯЗАТЕЛЬНО False в проде. SECRET_KEY теперь обязателен при
# DEBUG=False — сервер не стартует с небезопасным дефолтом.
DEBUG=False
SECRET_KEY=замени-на-длинный-случайный-ключ
ALLOWED_HOSTS=твой-домен.com,www.твой-домен.com
# Включить HTTPS-защиту (HSTS, SSL-redirect, secure-cookies). Ставить True
# ТОЛЬКО когда настроен домен + TLS-сертификат, иначе сайт станет недоступен.
SECURE_SSL=False

# ── ДОМЕН САЙТА (главная настройка!) ────────────────────────────
# Укажите ваш домен БЕЗ https:// и БЕЗ www
SITE_DOMAIN=твой-домен.com
# Домен API (обычно api.твой-домен.com, или тот же домен если без субдомена)
VITE_API_DOMAIN=твой-домен.com
# Канонический адрес сайта для SEO (canonical/Open Graph/sitemap).
# С протоколом, БЕЗ слэша в конце. Пока домена нет — можно оставить пустым
# (ссылки возьмут текущий origin браузера). Пример: https://твой-домен.com
VITE_SITE_URL=

# ── Email (Brevo SMTP) ────────────────────────────────────────
# Получить ключи в https://app.brevo.com/settings/keys/api
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ваш-логин@smtp-brevo.com
EMAIL_HOST_PASSWORD=ваш-smtp-пароль-от-brevo
DEFAULT_FROM_EMAIL=ваш-email@example.com

# Google OAuth (Client ID из console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=

# ── База данных PostgreSQL ────────────────────────────────────────
POSTGRES_DB=messhop
POSTGRES_USER=messhop
POSTGRES_PASSWORD=замени-на-сложный-пароль
